# LLM
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
AGENT_REVIEW_ENABLED=true
AGENT_MAX_COORDINATION_ROUNDS=2

# HAW ICC Fallback
HAW_ICC_API_KEY=your-haw-icc-api-key
HAW_ICC_BASE_URL=https://llm.inf.haw-hamburg.de/v1

# RAG
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small

# App
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-random-32-byte-secret

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studymummy
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/studymummy

# Production / Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

